{
    "version": 8,
    "configurePresets": [
        {
            "name": "Qt-MSVC2022-amd64-Ninja",
            "displayName": "Qt MSVC2022 64bit - Ninja Multi-Config",
            "description": "Ninja Multi-Config generator using Qt's bundled ninja and MSVC2022",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/support/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "Ubuntu-GCC-Ninja-debug",
            "displayName": "Ubuntu GCC 64bit - Ninja (Debug)",
            "description": "Ninja single-config generator using system GCC and apt-installed Qt6/libarchive/ICU (no vcpkg)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_BUILD_TYPE": "Debug"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "Ubuntu-GCC-Ninja-release",
            "displayName": "Ubuntu GCC 64bit - Ninja (Release)",
            "description": "Ninja single-config generator using system GCC and apt-installed Qt6/libarchive/ICU (no vcpkg)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}",
                "CMAKE_BUILD_TYPE": "Release"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Qt-MSVC2022-amd64-Ninja-debug",
            "displayName": "Qt MSVC2022 Ninja - Debug",
            "configurePreset": "Qt-MSVC2022-amd64-Ninja",
            "configuration": "Debug"
        },
        {
            "name": "Qt-MSVC2022-amd64-Ninja-release",
            "displayName": "Qt MSVC2022 Ninja - Release",
            "configurePreset": "Qt-MSVC2022-amd64-Ninja",
            "configuration": "Release"
        },
        {
            "name": "Ubuntu-GCC-Ninja-debug",
            "displayName": "Ubuntu GCC Ninja - Debug",
            "configurePreset": "Ubuntu-GCC-Ninja-debug"
        },
        {
            "name": "Ubuntu-GCC-Ninja-release",
            "displayName": "Ubuntu GCC Ninja - Release",
            "configurePreset": "Ubuntu-GCC-Ninja-release"
        }
    ],
    "testPresets": [
        {
            "name": "Ubuntu-GCC-Ninja-debug",
            "displayName": "Ubuntu GCC Ninja - Debug Tests",
            "configurePreset": "Ubuntu-GCC-Ninja-debug",
            "environment": { "QT_QPA_PLATFORM": "offscreen" },
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        },
        {
            "name": "Ubuntu-GCC-Ninja-release",
            "displayName": "Ubuntu GCC Ninja - Release Tests",
            "configurePreset": "Ubuntu-GCC-Ninja-release",
            "environment": { "QT_QPA_PLATFORM": "offscreen" },
            "output": { "outputOnFailure": true },
            "execution": { "noTestsAction": "error" }
        }
    ],
    "packagePresets": [
        {
            "name": "win64-zip",
            "displayName": "Windows 64-bit ZIP",
            "configurePreset": "Qt-MSVC2022-amd64-Ninja",
            "generators": ["ZIP"],
            "configurations": ["Release"]
        },
        {
            "name": "ubuntu-deb",
            "displayName": "Ubuntu 64-bit DEB",
            "configurePreset": "Ubuntu-GCC-Ninja-release",
            "generators": ["DEB"]
        }
    ]
}
